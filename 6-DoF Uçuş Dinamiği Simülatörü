#define DYNAMICS_H
#include <stdint.h>
typedef struct {
double pos[3];      /* Inertial NED position: x, y, z [m] /
double vel[3];      / Body velocity: u, v, w [m/s] /
double quat[4];     / Attitude unit quaternion: q0, q1, q2, q3 /
double omega[3];    / Body angular rates: p, q, r [rad/s] */
} State6DoF;
typedef struct {
double mass;        /* Vehicle mass [kg] /
double Ixx, Iyy, Izz, Ixz; / Moments of inertia [kg*m^2] /
double S_ref;       / Reference wing area [m^2] /
double c_bar;       / Mean aerodynamic chord [m] /
double b_span;      / Wing span [m] /
double CL0, CLa;    / Lift curve parameters /
double CD0, k_ind;  / Drag polar parameters /
double Cm0, Cma, Cmq; / Pitch moment derivatives */
} AircraftParams;
typedef struct {
double thrust;      /* Axial thrust [N] /
double de;          / Elevator deflection [rad] /
double da;          / Aileron deflection [rad] /
double dr;          / Rudder deflection [rad] */
} ControlInputs;
void dynamics_init_default_uav(AircraftParams *params);
void dynamics_step_rk4(State6DoF *state, const AircraftParams *params, const ControlInputs *ctrl, double dt);
void dynamics_quat_to_euler(const double q[4], double *roll, double *pitch, double *yaw);
#endif /* DYNAMICS_H */
"""
6. src/dynamics.c
dynamics_c = """#include "dynamics.h"
#include <math.h>
#define GRAVITY 9.80665
#define RHO_SEA_LEVEL 1.225
void dynamics_init_default_uav(AircraftParams *params) {
params->mass = 25.0;
params->Ixx = 2.4;
params->Iyy = 3.8;
params->Izz = 5.6;
params->Ixz = 0.15;
params->S_ref = 1.45;
params->c_bar = 0.42;
params->b_span = 3.45;
params->CL0 = 0.24;
params->CLa = 4.85;
params->CD0 = 0.028;
params->k_ind = 0.045;
params->Cm0 = 0.02;
params->Cma = -0.65;
params->Cmq = -12.4;
}
static void compute_derivatives(const State6DoF *s, const AircraftParams *p, const ControlInputs *u_ctrl, State6DoF *ds) {
double u = s->vel[0], v = s->vel[1], w = s->vel[2];
double q0 = s->quat[0], q1 = s->quat[1], q2 = s->quat[2], q3 = s->quat[3];
double p_rate = s->omega[0], q_rate = s->omega[1], r_rate = s->omega[2];
double V = sqrt(u * u + v * v + w * w);
if (V < 1e-3) V = 1e-3;
double alpha = atan2(w, u);
double q_bar = 0.5 * RHO_SEA_LEVEL * V * V;
/* Aerodynamic coefficients */
double CL = p->CL0 + p->CLa * alpha + 0.35 * u_ctrl->de;
double CD = p->CD0 + p->k_ind * CL * CL;
double Cm = p->Cm0 + p->Cma * alpha + p->Cmq * (q_rate * p->c_bar / (2.0 * V)) - 1.15 * u_ctrl->de;
double Cl = -0.12 * (p_rate * p->b_span / (2.0 * V)) + 0.18 * u_ctrl->da;
double Cn = -0.15 * (r_rate * p->b_span / (2.0 * V)) - 0.10 * u_ctrl->dr;
double Lift = q_bar * p->S_ref * CL;
double Drag = q_bar * p->S_ref * CD;
double ca = cos(alpha), sa = sin(alpha);
double Fx_aero = -Drag * ca + Lift * sa;
double Fy_aero = -0.25 * q_bar * p->S_ref * (v / V);
double Fz_aero = -Drag * sa - Lift * ca;
/* Gravity vector rotated into body frame */
double gx = 2.0 * (q1 * q3 - q0 * q2) * GRAVITY;
double gy = 2.0 * (q2 * q3 + q0 * q1) * GRAVITY;
double gz = (q0 * q0 - q1 * q1 - q2 * q2 + q3 * q3) * GRAVITY;
double Fx = Fx_aero + u_ctrl->thrust + p->mass * gx;
double Fy = Fy_aero + p->mass * gy;
double Fz = Fz_aero + p->mass * gz;
/* Translational accelerations */
ds->vel[0] = (Fx / p->mass) - (q_rate * w - r_rate * v);
ds->vel[1] = (Fy / p->mass) - (r_rate * u - p_rate * w);
ds->vel[2] = (Fz / p->mass) - (p_rate * v - q_rate * u);
/* Moments */
double L_mom = q_bar * p->S_ref * p->b_span * Cl;
double M_mom = q_bar * p->S_ref * p->c_bar * Cm;
double N_mom = q_bar * p->S_ref * p->b_span * Cn;
/* Rotational accelerations (diagonal inertia approximation for clean deterministic execution) */
ds->omega[0] = (L_mom - (p->Izz - p->Iyy) * q_rate * r_rate) / p->Ixx;
ds->omega[1] = (M_mom - (p->Ixx - p->Izz) * r_rate * p_rate) / p->Iyy;
ds->omega[2] = (N_mom - (p->Iyy - p->Ixx) * p_rate * q_rate) / p->Izz;
/* Quaternion kinematics */
ds->quat[0] = 0.5 * (-q1 * p_rate - q2 * q_rate - q3 * r_rate);
ds->quat[1] = 0.5 * ( q0 * p_rate + q2 * r_rate - q3 * q_rate);
ds->quat[2] = 0.5 * ( q0 * q_rate - q1 * r_rate + q3 * p_rate);
ds->quat[3] = 0.5 * ( q0 * r_rate + q1 * q_rate - q2 * p_rate);
/* Inertial position derivatives (DCM * V_body) /
double r11 = q0q0 + q1q1 - q2q2 - q3q3;
double r12 = 2.0(q1q2 - q0q3);
double r13 = 2.0*(q1q3 + q0q2);
double r21 = 2.0*(q1q2 + q0q3);
double r22 = q0q0 - q1q1 + q2q2 - q3q3;
double r23 = 2.0*(q2q3 - q0q1);
double r31 = 2.0*(q1q3 - q0q2);
double r32 = 2.0*(q2q3 + q0q1);
double r33 = q0q0 - q1q1 - q2q2 + q3q3;
ds->pos[0] = r11 * u + r12 * v + r13 * w;
ds->pos[1] = r21 * u + r22 * v + r23 * w;
ds->pos[2] = r31 * u + r32 * v + r33 * w;
}
static void state_add_scaled(State6DoF *out, const State6DoF *base, const State6DoF *k, double scale) {
for (int i = 0; i < 3; i++) {
out->pos[i] = base->pos[i] + scale * k->pos[i];
out->vel[i] = base->vel[i] + scale * k->vel[i];
out->omega[i] = base->omega[i] + scale * k->omega[i];
}
for (int i = 0; i < 4; i++) {
out->quat[i] = base->quat[i] + scale * k->quat[i];
}
}
void dynamics_step_rk4(State6DoF *s, const AircraftParams *p, const ControlInputs *ctrl, double dt) {
State6DoF k1, k2, k3, k4, temp;
compute_derivatives(s, p, ctrl, &k1);
state_add_scaled(&temp, s, &k1, 0.5 * dt);
compute_derivatives(&temp, p, ctrl, &k2);
state_add_scaled(&temp, s, &k2, 0.5 * dt);
compute_derivatives(&temp, p, ctrl, &k3);
state_add_scaled(&temp, s, &k3, dt);
compute_derivatives(&temp, p, ctrl, &k4);
for (int i = 0; i < 3; i++) {
s->pos[i] += (dt / 6.0) * (k1.pos[i] + 2.0 * k2.pos[i] + 2.0 * k3.pos[i] + k4.pos[i]);
s->vel[i] += (dt / 6.0) * (k1.vel[i] + 2.0 * k2.vel[i] + 2.0 * k3.vel[i] + k4.vel[i]);
s->omega[i] += (dt / 6.0) * (k1.omega[i] + 2.0 * k2.omega[i] + 2.0 * k3.omega[i] + k4.omega[i]);
}
for (int i = 0; i < 4; i++) {
s->quat[i] += (dt / 6.0) * (k1.quat[i] + 2.0 * k2.quat[i] + 2.0 * k3.quat[i] + k4.quat[i]);
}
/* Algebraic quaternion renormalization */
double norm = sqrt(s->quat[0]*s->quat[0] + s->quat[1]*s->quat[1] + s->quat[2]*s->quat[2] + s->quat[3]*s->quat[3]);
if (norm > 1e-12) {
for (int i = 0; i < 4; i++) s->quat[i] /= norm;
}
}
void dynamics_quat_to_euler(const double q[4], double *roll, double *pitch, double *yaw) {
double sinr_cosp = 2.0 * (q[0] * q[1] + q[2] * q[3]);
double cosr_cosp = 1.0 - 2.0 * (q[1] * q[1] + q[2] * q[2]);
*roll = atan2(sinr_cosp, cosr_cosp);
double sinp = 2.0 * (q[0] * q[2] - q[3] * q[1]);
if (fabs(sinp) >= 1.0)
*pitch = copysign(3.14159265358979323846 / 2.0, sinp);
else
*pitch = asin(sinp);
double siny_cosp = 2.0 * (q[0] * q[3] + q[1] * q[2]);
double cosy_cosp = 1.0 - 2.0 * (q[2] * q[2] + q[3] * q[3]);
*yaw = atan2(siny_cosp, cosy_cosp);
}
"""
