telemetry_c = """#include "dynamics.h"
#include <stddef.h>
#include <string.h>
#pragma pack(push, 1)
typedef struct {
uint16_t sync_word;     /* 0xAA55 */
uint32_t timestamp_ms;
float pos_ned[3];
float vel_body[3];
float euler_rad[3];
uint16_t crc16;
} TelemetryPacket;
#pragma pack(pop)
static uint16_t compute_crc16(const uint8_t *data, size_t len) {
uint16_t crc = 0xFFFF;
for (size_t i = 0; i < len; i++) {
crc ^= (uint16_t)data[i] << 8;
for (int j = 0; j < 8; j++) {
if (crc & 0x8000) crc = (crc << 1) ^ 0x1021;
else crc <<= 1;
}
}
return crc;
}
size_t telemetry_pack_state(const State6DoF *state, uint32_t time_ms, uint8_t *out_buf, size_t max_len) {
if (max_len < sizeof(TelemetryPacket)) return 0;
TelemetryPacket pkt;
pkt.sync_word = 0xAA55;
pkt.timestamp_ms = time_ms;
for (int i = 0; i < 3; i++) {
pkt.pos_ned[i] = (float)state->pos[i];
pkt.vel_body[i] = (float)state->vel[i];
}
double r, p, y;
dynamics_quat_to_euler(state->quat, &r, &p, &y);
pkt.euler_rad[0] = (float)r;
pkt.euler_rad[1] = (float)p;
pkt.euler_rad[2] = (float)y;
pkt.crc16 = compute_crc16((const uint8_t *)&pkt, sizeof(TelemetryPacket) - sizeof(uint16_t));
memcpy(out_buf, &pkt, sizeof(TelemetryPacket));
return sizeof(TelemetryPacket);
}
"""
