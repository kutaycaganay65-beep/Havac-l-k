aero_py = """#!/usr/bin/env python3
"""
Aerodynamic Polar & L/D Ratio Analysis Tool
Computes lift, drag, and glide efficiency across Angle of Attack (AoA) sweeps.
"""
import math
import csv
def analyze_polar(cl0=0.24, cla=4.85, cd0=0.028, k_ind=0.045, aoa_min=-4.0, aoa_max=14.0, step=1.0):
results = []
aoa = aoa_min
while aoa <= aoa_max + 1e-6:
alpha_rad = math.radians(aoa)
cl = cl0 + cla * alpha_rad
cd = cd0 + k_ind * (cl  2)
ld_ratio = cl / cd if cd > 0 else 0.0
results.append({
"aoa_deg": round(aoa, 2),
"CL": round(cl, 4),
"CD": round(cd, 5),
"L_D": round(ld_ratio, 2)
})
aoa += step
return results
if name == "main":
polar_data = analyze_polar()
best = max(polar_data, key=lambda r: r["L_D"])
print(f"Max L/D Ratio: {best['L_D']} at AoA = {best['aoa_deg']} deg (CL={best['CL']}, CD={best['CD']})")
with open("results/aero_polar.csv", "w", newline="") as f:
writer = csv.DictWriter(f, fieldnames=["aoa_deg", "CL", "CD", "L_D"])
writer.writeheader()
writer.writerows(polar_data)
print("Exported results/aero_polar.csv")
"""
